# Supply Chain Pulse 2.0 end-to-end tests (story S5, Playwright).
# Used by `npm run test:e2e` (vite build --mode e2e). The live 2.0 build, with
# the real portal handoff, permission check and API client. The hosts below do
# not exist: Playwright answers every request to them (e2e/stubs.ts), so the
# tests never reach a real authenticator, scorecard-be or BigQuery.
VITE_APP_VERSION=2
VITE_DEMO_DATA=false
VITE_API_BASE_URL=http://api.e2e.invalid/api
VITE_AUTH_PORTAL_URL=http://portal.e2e.invalid/
VITE_AUTH_API_URL=http://auth.e2e.invalid/api
