# Supply Chain Pulse 2.0 on live data, local development (stories S3/S4).
# Used by `npm run dev:v2live` and `npm run build:v2live` (vite --mode v2live).
# Needs scorecard-be v2 (`npm run start:v2`, port 3012) and the authenticator.
VITE_APP_VERSION=2
VITE_DEMO_DATA=false
VITE_API_BASE_URL=http://localhost:3012/api
VITE_AUTH_PORTAL_URL=http://localhost:5173/
VITE_AUTH_API_URL=http://localhost:4002/api
